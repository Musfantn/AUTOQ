# ── Installer output (Inno Setup) ─────────────────────────────────────────────
installer/

# ── PyInstaller build artifacts ───────────────────────────────────────────────
dist/
build/
*.spec.bak

# ── Python cache & environments ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/
ENV/

# ── Database (dữ liệu local, không commit) ────────────────────────────────────
database/
*.db
*.sqlite3

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Environment variables (bí mật, cấu hình cá nhân) ─────────────────────────
.env
.env.local
.env.*.local

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea

